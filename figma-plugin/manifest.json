{
  "name": "Pixelworks Bridge (cloud)",
  "id": "pixelworks-bridge-cloud",
  "api": "1.0.0",
  "main": "code.js",
  "ui": "ui.html",
  "editorType": [
    "figma"
  ],
  "documentAccess": "dynamic-page",
