# For running the bridge on your own computer (npm start). On Render, set these in the dashboard instead.
BRIDGE_USER=choose-a-username
BRIDGE_PASSWORD=choose-a-long-password-at-least-8-characters
ROBLOX_API_KEY=your-open-cloud-key-with-Assets-read-and-write
ROBLOX_CREATOR_ID=your-roblox-user-id
ROBLOX_CREATOR_TYPE=user
MAX_UPLOADS_PER_SEND=30
